# Kopieren nach .env und Werte anpassen:  cp .env.example .env

# Port, unter dem der Shop auf dem Host erreichbar ist
APP_PORT=3000

# Admin Zugang (/admin). Ohne Passwort wird beim ersten Start eines erzeugt und im Log ausgegeben.
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-unbedingt-aendern

# Optional: fester Schlüssel für Login Cookies (sonst automatisch erzeugt und in ./data gespeichert)
SESSION_SECRET=

# Zeitzone für Zeitslots und Vorlaufzeit
APP_TIMEZONE=Europe/Berlin

# Hinter einem HTTPS Reverse Proxy (Traefik, Caddy, nginx):
# COOKIE_SECURE=true setzt das Login Cookie nur über HTTPS,
# TRUST_PROXY=1 sorgt dafür, dass die echte Besucher IP erkannt wird.
COOKIE_SECURE=false
TRUST_PROXY=false

# Maximale Bestellungen pro IP Adresse in 10 Minuten (Schutz vor Spam).
# Bei Events, an denen viele Gäste im selben WLAN bestellen, großzügig wählen.
ORDER_RATE_LIMIT=60

# Demo Speisekarte und Slots für heute und morgen beim allerersten Start anlegen
SEED_DEMO_DATA=true

# WhatsApp über WAHA (wird vorbelegt, danach im Admin Bereich änderbar)
WAHA_URL=http://waha:3000
WAHA_SESSION=default
# Gilt für den WAHA Container UND die App. Erzeugen z. B. mit:  openssl rand -hex 24
WAHA_API_KEY=bitte-einen-langen-zufallswert-eintragen

# Den WAHA Container mitstarten (auskommentieren, wenn WAHA woanders läuft)
COMPOSE_PROFILES=waha
WAHA_PORT=3001
WAHA_BIND=127.0.0.1
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=bitte-ebenfalls-aendern

# E-Mail Versand per SMTP (wird vorbelegt, danach im Admin Bereich änderbar)
# Port 587 mit SMTP_SECURE=false (STARTTLS) oder Port 465 mit SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=
