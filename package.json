{
  "name": "pizza-vorbestellung",
  "version": "1.0.0",
  "description": "Selbst hostbares Pizza Vorbestellsystem mit Zeitslot Management, Küchenansicht, WhatsApp (WAHA) und E-Mail Benachrichtigung",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./frontend/styles.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./frontend/styles.css -o ./public/css/app.css --watch",
    "test": "node --test test/*.test.js",
    "reset-password": "node src/cli/reset-password.js"
  },
  "dependencies": {
    "alpinejs": "3.17.4",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "nodemailer": "10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
